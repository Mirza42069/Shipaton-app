{
  "name": "Mobile-APP",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "convex": "^1.42.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:server": "bun run --filter @Mobile-APP/backend dev",
    "dev:setup": "bun run --filter @Mobile-APP/backend dev:setup"
  },
  "dependencies": {
    "@Mobile-APP/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Mobile-APP/config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.6"
}
